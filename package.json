{
  "name": "@tele/call-ui",
  "version": "0.2.1",
  "description": "Prebuilt Tele call UI: the <tele-call> custom element and a React wrapper",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map"
  ],
  "sideEffects": true,
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test 'src/**/*.test.ts'",
    "prepare": "node build.mjs",
    "docs": "uvx --python 3.12 zensical@0.0.66 serve",
    "docs:build": "uvx --python 3.12 zensical@0.0.66 build --strict"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "peerDependencies": {
    "livekit-client": "^2.15.0",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "esbuild": "0.28.2",
    "livekit-client": "2.22.3",
    "react": "19.3.0",
    "typescript": "6.0.3"
  },
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/cloudguys-io/tele-ui-pack.git"
  },
  "homepage": "https://github.com/cloudguys-io/tele-ui-pack#readme"
}
